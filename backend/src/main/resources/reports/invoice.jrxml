<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="invoice" pageWidth="595" pageHeight="842" columnWidth="535"
              leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30"
              whenNoDataType="AllSectionsNoDetail">

    <!--
      Real, printable invoice document - not a screenshot of the on-screen
      preview. Same JasperReports pattern established by profit_loss.jrxml:
      compiled at request time, filled from real invoice data, exported to
      PDF bytes.
    -->

    <parameter name="logoImage" class="java.io.InputStream"/>
    <parameter name="invoiceNumber" class="java.lang.Integer"/>
    <parameter name="invoiceDate" class="java.lang.String"/>
    <parameter name="paymentType" class="java.lang.String"/>
    <parameter name="customerName" class="java.lang.String"/>
    <parameter name="customerContact" class="java.lang.String"/>
    <parameter name="salesOfficerName" class="java.lang.String"/>
    <parameter name="totalAmount" class="java.math.BigDecimal"/>

    <field name="productName" class="java.lang.String"/>
    <field name="unitOfMeasure" class="java.lang.String"/>
    <field name="quantity" class="java.math.BigDecimal"/>
    <field name="unitPrice" class="java.math.BigDecimal"/>
    <field name="subtotal" class="java.math.BigDecimal"/>

    <title>
        <band height="170">
            <image>
                <reportElement x="0" y="0" width="54" height="54"/>
                <imageExpression><![CDATA[$P{logoImage}]]></imageExpression>
            </image>
            <staticText>
                <reportElement x="64" y="2" width="300" height="22"/>
                <textElement><font size="16" isBold="true"/></textElement>
                <text><![CDATA[Ceylon Sweets Island]]></text>
            </staticText>
            <staticText>
                <reportElement x="64" y="24" width="300" height="16"/>
                <textElement><font size="9" isItalic="true"/></textElement>
                <text><![CDATA[Sweets & Dairy Manufacturing]]></text>
            </staticText>

            <staticText>
                <reportElement x="365" y="0" width="170" height="24"/>
                <textElement textAlignment="Right"><font size="18" isBold="true"/></textElement>
                <text><![CDATA[INVOICE]]></text>
            </staticText>
            <textField>
                <reportElement x="365" y="26" width="170" height="16"/>
                <textElement textAlignment="Right"><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Invoice #" + $P{invoiceNumber}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="365" y="42" width="170" height="14"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Date: " + $P{invoiceDate}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="365" y="56" width="170" height="14"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Payment: " + $P{paymentType}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="0" y="80" width="535" height="1"/>
            </line>

            <staticText>
                <reportElement x="0" y="92" width="250" height="14"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Bill To]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="107" width="250" height="16"/>
                <textElement><font size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{customerName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="124" width="250" height="14"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{customerContact} == null ? "" : $P{customerContact}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="315" y="92" width="220" height="14"/>
                <textElement textAlignment="Right"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Served By]]></text>
            </staticText>
            <textField>
                <reportElement x="315" y="107" width="220" height="16"/>
                <textElement textAlignment="Right"><font size="10"/></textElement>
                <textFieldExpression><![CDATA[$P{salesOfficerName}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="0" y="150" width="535" height="1"/>
            </line>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="220" height="18"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Product]]></text>
            </staticText>
            <staticText>
                <reportElement x="220" y="0" width="90" height="18"/>
                <textElement textAlignment="Right"><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Quantity]]></text>
            </staticText>
            <staticText>
                <reportElement x="310" y="0" width="110" height="18"/>
                <textElement textAlignment="Right"><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Unit Price (Rs.)]]></text>
            </staticText>
            <staticText>
                <reportElement x="420" y="0" width="115" height="18"/>
                <textElement textAlignment="Right"><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Subtotal (Rs.)]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="19" width="535" height="1"/>
            </line>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="220" height="18"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{productName}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="220" y="0" width="90" height="18"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{quantity} + ($F{unitOfMeasure} == null || $F{unitOfMeasure}.isBlank() ? "" : " " + $F{unitOfMeasure})]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="310" y="0" width="110" height="18"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{unitPrice}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="420" y="0" width="115" height="18"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{subtotal}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="90">
            <line>
                <reportElement x="315" y="10" width="220" height="1"/>
            </line>
            <staticText>
                <reportElement x="315" y="22" width="110" height="20"/>
                <textElement><font size="13" isBold="true"/></textElement>
                <text><![CDATA[Total Amount]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="420" y="22" width="115" height="20"/>
                <textElement textAlignment="Right"><font size="13" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Rs. " + new java.text.DecimalFormat("#,##0.00").format($P{totalAmount})]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="60" width="535" height="26"/>
                <textElement><font size="8" isItalic="true"/></textElement>
                <text><![CDATA[Thank you for your business — Ceylon Sweets Island.
This is a system-generated invoice.]]></text>
            </staticText>
        </band>
    </summary>

</jasperReport>
