<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="profit_loss" pageWidth="595" pageHeight="842" columnWidth="535"
              leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30"
              whenNoDataType="AllSectionsNoDetail">

    <!--
      Profit & Loss report, per proposal section 5.7: "Monthly income vs.
      expenditure analysis" - extended to Weekly/Monthly/Yearly (see
      reportTypeLabel). Revenue = total invoice value in the period.
      Expenditure = approved GRN raw-material cost in the period. This is a
      documented simplification (no labor/overhead/damage-cost tracking
      exists in the schema), not a full accounting P&L - the report says so
      explicitly so it can never be mistaken for one.
    -->

    <parameter name="logoImage" class="java.io.InputStream"/>
    <parameter name="reportTypeLabel" class="java.lang.String"/>
    <parameter name="periodLabel" class="java.lang.String"/>
    <parameter name="generatedAt" class="java.lang.String"/>
    <parameter name="totalRevenue" class="java.lang.Double"/>
    <parameter name="totalExpenditure" class="java.lang.Double"/>
    <parameter name="netProfit" class="java.lang.Double"/>

    <field name="label" class="java.lang.String"/>
    <field name="revenue" class="java.lang.Double"/>
    <field name="expenditure" class="java.lang.Double"/>
    <field name="netResult" class="java.lang.Double"/>

    <title>
        <band height="130">
            <image>
                <reportElement x="0" y="0" width="44" height="44"/>
                <imageExpression><![CDATA[$P{logoImage}]]></imageExpression>
            </image>
            <staticText>
                <reportElement x="54" y="0" width="481" height="20"/>
                <textElement><font size="15" isBold="true"/></textElement>
                <text><![CDATA[Ceylon Sweets Island]]></text>
            </staticText>
            <textField>
                <reportElement x="54" y="20" width="481" height="18"/>
                <textElement><font size="13" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{reportTypeLabel}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="52" width="535" height="16"/>
                <textElement><font size="11"/></textElement>
                <textFieldExpression><![CDATA["Period: " + $P{periodLabel}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="70" width="535" height="14"/>
                <textElement><font size="9" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA["Generated: " + $P{generatedAt}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="90" width="535" height="34"/>
                <textElement><font size="8" isItalic="true"/></textElement>
                <text><![CDATA[Note: revenue is total invoice value in this period. Expenditure is approved raw-material purchase cost (GRN) in this period. This figure does not include labor, overhead, or damaged-stock cost, and is not a certified accounting statement.]]></text>
            </staticText>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="135" height="18"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Period]]></text>
            </staticText>
            <staticText>
                <reportElement x="135" y="0" width="130" height="18"/>
                <textElement textAlignment="Right"><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Revenue (Rs.)]]></text>
            </staticText>
            <staticText>
                <reportElement x="270" y="0" width="130" height="18"/>
                <textElement textAlignment="Right"><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Expenditure (Rs.)]]></text>
            </staticText>
            <staticText>
                <reportElement x="405" y="0" width="130" height="18"/>
                <textElement textAlignment="Right"><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Net (Rs.)]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <textField>
                <reportElement x="0" y="0" width="135" height="16"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{label}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="135" y="0" width="130" height="16"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{revenue}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="270" y="0" width="130" height="16"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{expenditure}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="405" y="0" width="130" height="16"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{netResult}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="90">
            <line>
                <reportElement x="0" y="10" width="535" height="1"/>
            </line>
            <staticText>
                <reportElement x="0" y="20" width="270" height="18"/>
                <textElement><font size="11" isBold="true"/></textElement>
                <text><![CDATA[Total Revenue]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="270" y="20" width="265" height="18"/>
                <textElement textAlignment="Right"><font size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Rs. " + new java.text.DecimalFormat("#,##0.00").format($P{totalRevenue})]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="40" width="270" height="18"/>
                <textElement><font size="11" isBold="true"/></textElement>
                <text><![CDATA[Total Expenditure (Raw Materials)]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="270" y="40" width="265" height="18"/>
                <textElement textAlignment="Right"><font size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Rs. " + new java.text.DecimalFormat("#,##0.00").format($P{totalExpenditure})]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="64" width="270" height="20"/>
                <textElement><font size="13" isBold="true"/></textElement>
                <text><![CDATA[Net Profit / (Loss)]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="270" y="64" width="265" height="20"/>
                <textElement textAlignment="Right"><font size="13" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Rs. " + new java.text.DecimalFormat("#,##0.00").format($P{netProfit})]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
